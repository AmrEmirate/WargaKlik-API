# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=iuran_rt
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=your_jwt_secret_change_this_to_64_random_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_this_to_64_random_chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_EXPIRE_DAYS=7

# Midtrans (Sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# Frontend URLs
USE_NGROK=false
LOCAL_FRONTEND_URL=http://localhost:3000
NGROK_FRONTEND_URL=

# Deprecated (Replaced by config/env.js)
FRONTEND_URL=http://localhost:3000

# WhatsApp Service
WHATSAPP_ENABLED=false
